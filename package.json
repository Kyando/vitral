  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/pngjs": "^6.0.5",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
